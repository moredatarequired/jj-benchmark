# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

__pycache__/
*.py[cod]
*$py.class

# testing
coverage

# next.js
.next/

# The `out` directory should not be ignored by version control
out/

# production
build

# misc
.DS_Store
*.pem
*~
\#*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent worktrees
.worktrees/

# Generated / run artifacts. These are produced by benchmark runs and by the
# site build, not hand-maintained, and they dwarf the source tree.
#   scratchpad/ - raw sample-case working dirs from exploratory runs
#   jobs/       - per-run agent trajectories and results
#   .zealt/tasks.json + .zealt/pending-tasks.json are regenerated by
#   site/scripts/compute-tasks.ts on every `bun run dev` / `bun run build`.
# .zealt/config.json is NOT ignored: it is hand-maintained input.
scratchpad/
jobs/
.zealt/tasks.json
.zealt/pending-tasks.json

# The bootstrap integrity anchor is a PER-BUILD artifact, not a repo constant,
# so it must never be committed. jj generates change ids randomly at commit
# creation, so two builds of the same Dockerfile produce disjoint change id
# sets -- a committed anchor would be wrong for every build except the one that
# produced it, and CI always builds cold, so it would fail permanently.
# Generate it on the host immediately before a sweep with
# `python3 scripts/bootstrap_anchor.py --write`; tests/anchor.py ABSTAINS when
# the file is absent, which is why not committing it is safe.
tasks/*/tests/bootstrap_anchor.json
