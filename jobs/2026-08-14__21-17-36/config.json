{
    "n_attempts": 10,
    "agent_setup_timeout_multiplier": 2.5,
    "n_concurrent_trials": 8,
    "retry": {
        "max_retries": 5,
        "include_exceptions": [
            "AgentSetupTimeoutError",
            "EnvironmentStartTimeoutError",
            "RuntimeError"
        ]
    },
    "environment": {
        "type": "docker",
        "override_memory_mb": 2048
    },
    "agents": [
        {
            "name": "claude-code",
            "model_name": "claude-haiku-4-5-20251001"
        },
        {
            "name": "claude-code",
            "model_name": "claude-sonnet-5"
        }
    ],
    "datasets": [
        {
            "path": "tasks"
        }
    ]
}